OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b

# Groq LLM (preferred). When GROQ_API_KEY is set, generation uses Groq instead of Ollama.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Local all-MiniLM-L6-v2 embeddings via fastembed/ONNX (downloads ~90MB once into data/models)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
FAISS_BASE_PATH=./data/faiss
AI_SERVICE_PORT=8000
TOP_K=5

# YouTube transcripts (public captions via youtube-transcript-api; no API key needed)
YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=45
YOUTUBE_MAX_TRANSCRIPT_WORDS=150000
# Optional: only needed if YouTube blocks this server's IP (common on cloud hosts).
# Webshare residential proxies are a paid service; leave empty to connect directly.
YOUTUBE_WEBSHARE_PROXY_USERNAME=
YOUTUBE_WEBSHARE_PROXY_PASSWORD=
# Or any HTTP(S) proxy, e.g. http://user:pass@host:port
YOUTUBE_PROXY_HTTP_URL=
YOUTUBE_PROXY_HTTPS_URL=
