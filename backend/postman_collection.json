{
  "info": {
    "name": "PREPMIND Authentication & Security API",
    "description": "Complete Postman collection for PrepMind Auth, Token Lifecycle, Password Recovery, Profile Management, and RBAC.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rana Ruchi\",\n  \"email\": \"raruchi2206@gmail.com\",\n  \"password\": \"StrongPassword@123\",\n  \"confirmPassword\": \"StrongPassword@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"raruchi2206@gmail.com\",\n  \"password\": \"StrongPassword@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Auth - Get Current User (/api/auth/me)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        }
      }
    },
    {
      "name": "4. Auth - Refresh Token",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "refresh"]
        }
      }
    },
    {
      "name": "5. Auth - Logout",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "logout"]
        }
      }
    },
    {
      "name": "6. Password Recovery - Forgot Password (Send OTP)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"raruchi2206@gmail.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "forgot-password"]
        }
      }
    },
    {
      "name": "7. Password Recovery - Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"raruchi2206@gmail.com\",\n  \"otp\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/verify-reset-otp",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "verify-reset-otp"]
        }
      }
    },
    {
      "name": "8. Password Recovery - Resend OTP",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"raruchi2206@gmail.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/resend-reset-otp",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "resend-reset-otp"]
        }
      }
    },
    {
      "name": "9. Password Recovery - Reset Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resetToken\": \"YOUR_RESET_TOKEN_HERE\",\n  \"newPassword\": \"NewStrongPassword@123\",\n  \"confirmPassword\": \"NewStrongPassword@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "reset-password"]
        }
      }
    },
    {
      "name": "10. Auth - Change Password (Authenticated)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"StrongPassword@123\",\n  \"newPassword\": \"NewStrongPassword@123\",\n  \"confirmPassword\": \"NewStrongPassword@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/change-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "change-password"]
        }
      }
    },
    {
      "name": "11. Users - Get Current Profile (/api/users/me)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        }
      }
    },
    {
      "name": "12. Users - Update Profile (/api/users/profile)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rana Ruchi Updated\",\n  \"avatar\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "profile"]
        }
      }
    },
    {
      "name": "13. Admin - Ping RBAC Check (/api/admin/ping)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/admin/ping",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "ping"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ]
}
