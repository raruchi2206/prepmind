NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/prepmind
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173
# COOKIE_DOMAIN=localhost
AI_SERVICE_URL=http://127.0.0.1:8000

# AI Hybrid Provider Configuration
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=ollama

# Primary Text-Generation Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Fallback Text-Generation & Local Embeddings: Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5vl:3b
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=all-minilm:latest
