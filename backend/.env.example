NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/prepmind
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173
# COOKIE_DOMAIN=localhost
AI_SERVICE_URL=http://127.0.0.1:8000

# Groq (text generation) and the local all-MiniLM-L6-v2 embedding model are
# configured in ai-service/.env, not here. See ai-service/.env.example.
